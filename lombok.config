# Applies to all ODE modules; lombok stops looking in parent directories here.
config.stopBubbling = true
# Lombok 1.18.40+ no longer copies Jackson annotations such as @JsonProperty from fields to the
# generated getters and setters.  Without the copy, a field whose name doesn't follow the JavaBeans
# convention is serialized twice, e.g. OdeMessageFrameMetadata.isCertPresent as both
# "isCertPresent" and "certPresent".  Keep the old behavior, as jpo-asn-pojos does.
lombok.copyJacksonAnnotationsToAccessors = true
